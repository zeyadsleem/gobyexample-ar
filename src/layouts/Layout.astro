---
import { Font } from "astro:assets";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Go بالأمثلة هي مقدمة عملية للغة Go باستخدام برامج توضيحية مشروحة." } = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/gobyexample-ar/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<Font cssVariable="--font-noto-sans-arabic" preload={[{ weight: 400 }]} />
		<Font cssVariable="--font-amiri" preload={[{ weight: 700 }]} />
		<Font cssVariable="--font-jetbrains-mono" />
	</head>
	<body>
		<slot />
		<script>
			if ("serviceWorker" in navigator && import.meta.env.PROD) {
				const base = import.meta.env.BASE_URL.endsWith("/")
					? import.meta.env.BASE_URL
					: `${import.meta.env.BASE_URL}/`;
				navigator.serviceWorker.register(`${base}sw.js`, { scope: base });
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #1f1f1f;
		--text-color: #dadada;
		--code-bg: #282828;
		--link-color: #e4e4e4;
		--footer-color: #898e98;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-color);
		font-family: var(--font-noto-sans-arabic);
		font-size: 18px; /* Increased for better Arabic legibility */
		line-height: 1.8;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: var(--link-color);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	pre, code {
		font-family: var(--font-jetbrains-mono);
		font-size: 15px; /* Slightly bigger for clarity as requested */
		line-height: 1.5;
	}

	/* Inline code styling - matching original site */
	p code {
		background-color: #333;
		color: #eee;
		padding: 2px 4px;
		border-radius: 3px;
		font-size: 0.9em;
	}

	h2 {
		font-weight: bold;
	}

	em {
		font-style: italic;
	}
</style>
